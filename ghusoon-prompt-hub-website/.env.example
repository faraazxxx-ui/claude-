# Langfuse Cloud (EU). Other regions:
#   US: https://us.cloud.langfuse.com
#   JP: https://jp.cloud.langfuse.com
#   HIPAA: https://hipaa.cloud.langfuse.com
# Or your self-hosted URL.
# Create keys in Langfuse: Project Settings > API Keys
# https://cloud.langfuse.com  (free account: https://langfuse.com/cloud)

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Browser SDK (public key only — never put the secret key in VITE_* vars)
VITE_LANGFUSE_PUBLIC_KEY=pk-lf-...
VITE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
