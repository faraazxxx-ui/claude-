{
  "watch_dir": "./scans",
  "output_dir": "./processed",
  "archive_dir": "./archive",
  "audio_dir": "./audio",
  "highlight_colors": {
    "yellow": [[200, 255], [100, 150], [0, 100]],
    "green": [[0, 100], [100, 255], [0, 100]],
    "pink": [[200, 255], [0, 100], [150, 255]],
    "blue": [[150, 255], [0, 100], [0, 100]],
    "orange": [[0, 100], [100, 200], [200, 255]]
  },
  "timestamp_window": 300,
  "ocr_lang": "eng",
  "min_file_age": 2,
  "create_directories": true,
  "log_level": "INFO",
  "auto_archive": true,
  "match_audio": true,
  "highlight_sensitivity": 0.85,
  "min_highlight_area": 100,
  "max_file_size_mb": 50
}
